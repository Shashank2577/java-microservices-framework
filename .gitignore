.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/**/build/

# Python bytecode
__pycache__/
*.pyc

# IDE
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# OS
.DS_Store

# Local env overrides (never committed)
.env
.env.local
application-local.yml

# Heap / thread dumps
*.hprof
*.dump

# Obsidian per-machine metadata (committed vault is the markdown + frontmatter only)
.vault/.obsidian/
