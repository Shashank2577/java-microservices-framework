// markdownlint-cli2 config — light, opinion-dense markdown style.
// Rule reference: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
  "default": true,

  // Headings — keep loose; skills use H1 for title + many H2 sections.
  "MD013": false,        // line length — long table rows are fine
  "MD024": { "siblings_only": true },   // duplicate headings ok in different sections
  "MD025": { "front_matter_title": "" },// allow H1 even with frontmatter

  // Lists / spacing
  "MD007": { "indent": 2 },             // 2-space list indent
  "MD009": { "br_spaces": 0 },          // no trailing whitespace
  "MD012": { "maximum": 2 },            // up to 2 blank lines

  // Inline / code
  "MD026": false,       // trailing punctuation in headings — colons in our subheads are fine
  "MD033": false,       // inline HTML — allowed for <br>, callouts
  "MD036": false,       // emphasis-as-heading — used deliberately in tight skills
  "MD041": false,       // first line need not be H1 (frontmatter precedes)
  "MD046": { "style": "fenced" },

  // Frontmatter is YAML, parsed elsewhere
  "MD034": false        // bare URLs in YAML frontmatter are ok
}
